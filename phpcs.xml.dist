<?xml version="1.0"?>
<ruleset name="Gracewell Security Suite Pro">
  <description>WordPress Coding Standards for Gracewell backend PHP.</description>
  <file>gracewell-security-suite-pro.php</file>
  <file>includes</file>
  <exclude-pattern>*/includes/vendor/*</exclude-pattern>
  <file>uninstall.php</file>
  <file>admin/views</file>
  <arg name="extensions" value="php"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="gracewell-security-suite-pro"/></property></properties>
  </rule>
</ruleset>
